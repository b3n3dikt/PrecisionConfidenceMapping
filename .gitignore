.DS_Store
*.asv

# Fetched at setup time by code/setup_matlab_tm.sh — never committed. See
# config.sh's MATLAB_TM_DIR comment for why (UMN license, no redistribution).
/deps/matlab_tm/

# Fetched at setup time by code/setup_reprotm.sh (--pinned or --latest) —
# never committed. See config.sh's REPROTM_FETCHED_DIR comment.
/deps/reprotm_fetched/

# Generated by example_runs/synthetic/generate_demo_data.py — deterministic
# (fixed seed) and regenerated in seconds, so not worth vendoring in git.
/example_runs/synthetic/*.dtseries.nii
/example_runs/synthetic/*_motion_mask.txt
